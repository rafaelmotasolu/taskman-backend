# ==============================================================================
# Taskman Backend - Exemplo de Configuração de Ambiente (.env)
# Copie este arquivo para .env e ajuste os valores conforme seu ambiente.
# ==============================================================================

# Conexão com o Banco de Dados PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/taskmanager
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=sua_senha_segura_aqui

# Chave Criptográfica JWT (HMAC-SHA256 - no mínimo 256 bits em hexadecimal)
JWT_SECRET_KEY=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

# Conexão com Servidor Ollama (IA Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Porta do Servidor Spring Boot
PORT=8080

